# Postgres connection string. If using Supabase, use the CONNECTION POOLER
# (Transaction mode) URI, not the direct db.*.supabase.co host — the direct
# host is IPv6-only on new projects and won't resolve from most dev machines.
DATABASE_URL=

# Admin panel login credentials + session secret (generate a random 32+ char string for the secret)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Cloudinary (media uploads for the admin panel)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
